# Server-only configuration. Copy to .env. Never use VITE_ for credentials.
# External processing stays disabled until an operator configures and reviews terms.
VISION_ENABLED=false
VISION_DATA_PROCESSING_ACKNOWLEDGED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Port server. Bila VISION_PORT dikosongkan, server memakai PORT dari layanan hosting (bawaan 8787).
VISION_PORT=8787
# Origin yang boleh memanggil API. Sertakan alamat npm start (port di atas) agar halaman build bisa memanggil API.
VISION_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:8787,http://localhost:8787
VISION_TIMEOUT_MS=30000
# Supported timeout range 1..180000 ms. Client uses the status value plus 10000 ms grace.
# Voice reuses the same server model, credentials, activation, privacy, timeout, and usage limits.
VISION_MAX_CONCURRENCY=2
VISION_REQUESTS_PER_MINUTE=6
VISION_REQUESTS_PER_DAY=30

# Optional private SQLite database path. Default: .data/accounts.sqlite (relative to API cwd).
# Keep this file outside public/static folders and exclude it, WAL and SHM from sharing/backups of source code.
# BUKTILAUT_ACCOUNT_DB_PATH=C:/private-buktilaut/accounts.sqlite

# Optional Google OAuth web application credentials. Keep the secret on the server.
# Use the same origin as Vite or the production reverse proxy.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5173/api/account/google/callback

# Produksi: npm run build lalu npm start. Bila dist/index.html ada, server menyajikan
# halaman dan API dari satu alamat.
# Alamat listen server. Isi 0.0.0.0 bila hosting meneruskan trafik dari luar kontainer.
BUKTILAUT_HOST=127.0.0.1
# Nama host (tanpa skema dan port) yang boleh dilayani. Permintaan dengan header Host lain ditolak 403.
BUKTILAUT_ALLOWED_HOSTS=localhost,127.0.0.1
# true = cookie sesi selalu memakai atribut Secure. Wajib true untuk domain HTTPS di belakang reverse proxy.
BUKTILAUT_COOKIE_SECURE=false
# Contoh domain publik:
# BUKTILAUT_HOST=0.0.0.0
# BUKTILAUT_ALLOWED_HOSTS=localhost,127.0.0.1,buktilaut.example
# VISION_ALLOWED_ORIGINS=https://buktilaut.example
# BUKTILAUT_COOKIE_SECURE=true
